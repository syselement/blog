# Normalize text files and store them as LF
* text=auto

# Explicit text formats
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.svg  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.sh   text eol=lf

# Binary files - never modify line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
